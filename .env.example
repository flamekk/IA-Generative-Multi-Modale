# PostgreSQL/PGVector local (development only; set a private password before sharing).
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=maintidoc
PG_USER=maintidoc
PG_PASSWORD=maintidoc-local-only
PG_SCHEMA=public
PG_TEXT_TABLE=maintidoc_text
PG_IMAGE_TABLE=maintidoc_images

# Ollama desktop service and models already validated in this environment.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_GENERATION_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=bge-m3

# CLIP checkpoint is loaded locally; CPU avoids competing with Ollama for VRAM.
CLIP_MODEL=openai/clip-vit-base-patch32
CLIP_DEVICE=cpu
RETRIEVAL_TOP_K=6
